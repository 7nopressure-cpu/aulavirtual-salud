# ==============================================================================
# CONFIGURACIÓN DE SUPABASE Y ENTORNO (AULA VIRTUAL SALUD)
# ==============================================================================

# URL de tu proyecto de Supabase (ej: https://xyzcompany.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Clave pública anónima de Supabase (segura para exponer en el cliente)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.example_anon_key

# Clave de Servicio (SOLO Servidor - no compartir públicamente)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.example_service_role_key

# URL base de la aplicación (para generar enlaces de verificación y QR de certificados)
NEXT_PUBLIC_APP_URL=http://localhost:3000
